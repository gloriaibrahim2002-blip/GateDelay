# ==============================================================================
# Frontend Environment Variables Sample
# ==============================================================================

# Public API URL used during development and production.
# During local development, Next.js rewrites (proxies) requests to this URL.
# If unset, the proxy defaults to http://localhost:8080.
# Only safe, public environment variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Web socket or general backend connection fallback url
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
