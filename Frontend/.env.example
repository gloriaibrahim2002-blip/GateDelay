# GateDelay Frontend Environment Configuration Example

# Specifies the target backend API URL for Next.js rewrite proxy rules during local development.
# By default, local API requests to /api/v1/:path*, /api/:path*, and /backend/:path*
# will be transparently proxied to this backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Specifies the backend URL for WebSocket connections and other custom frontend routing.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Note: Only public, non-sensitive variables prefixed with 'NEXT_PUBLIC_' are exposed
# to the client browser. Never define server-side secrets (like API keys, private keys, or credentials) in this file.
